# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wager
DATABASE_PASSWORD=wager123
DATABASE_NAME=wager_db

# AWS/LocalStack
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Queues
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Application
NODE_ENV=development
PORT=3000
INSTANCE_ID=instance-1

# Worker Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_MAX_RETRIES=10
PENDING_REFERENCE_TTL_MINUTES=60

# Concurrency
MAX_RETRIES_ON_CONFLICT=5
RETRY_DELAY_BASE_MS=50
